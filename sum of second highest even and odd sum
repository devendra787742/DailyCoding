import java.util.*;
public class Main {
    public static int function(int[] arr, int n){
      if(arr == null || arr.length <=3){
        return 0;
      }
      int evenMax = Integer.MIN_VALUE , evenSecond = Integer.MIN_VALUE;
      int oddMax = Integer.MIN_VALUE , oddSecond = Integer.MIN_VALUE;
      for(int i=0; i<n; i++){
        if(i % 2==0){
          if(arr[i]>evenMax){
            evenSecond = evenMax;
            evenMax = arr[i];
          }
            else if(arr[i]>evenSecond){
              evenSecond = arr[i];
            
          }
        }
        else {
          if(arr[i]>oddMax){
            oddSecond = oddMax;
            oddMax = arr[i];
          }
          else if(arr[i]>oddSecond){
            oddSecond = arr[i];
          }
        }
      }
       return evenSecond + oddSecond;
       
    }
    public static void main(String[] args) {
      System.out.println("Hello, World!");
      Scanner sc  = new Scanner(System.in);
      int n = sc.nextInt();
      int arr[] = new int[n];
      for(int i=0; i<n; i++){
        arr[i] = sc.nextInt();
      }
      System.out.println("the total is " + function(arr, n));
      sc.close();
    }
}
