import java.util.*;

public class Main {
    public static int isprime(int n){
      for(int i=2; i<= Math.sqrt(n); i++){
        if(n%i==0){
          return 0;
        }
      }
      return 1;
    }
    public static void primeFactor(int num){
      for(int i=2; i<=num; i++){
        if(isprime(i)==1){
          int x = num;
          while(x%i==0){
           System.out.print(i + " ");
           x = x/i;
          }
        }
      }
    }
    public static void main(String[] args) {
      System.out.println("Hello, World!");
      Scanner sc = new Scanner(System.in);
      int num = sc.nextInt();
      primeFactor(num);
    }
}
