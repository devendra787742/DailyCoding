import java.util.*;

public class Main {
    public static void MaxNumberAndIndex(int[] arr, int n){
      int maxNumber = arr[0];
      int index = 0; 
      for(int i=0; i<n; i++){
        if(arr[i] > maxNumber){
          maxNumber = arr[i];
          index = i;
        }
      }
      System.out.println(maxNumber);
      System.out.println(index);
    }
    public static void main(String[] args) {
      System.out.println("Hello, World!");
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      int arr[] = new int[n];
      for(int i=0; i<n; i++){
          arr[i] = sc.nextInt();
      }
      MaxNumberAndIndex(arr, n);
    }
}
